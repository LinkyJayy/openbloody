{
  "name": "openbloody",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, browser-based configurator for A4Tech Bloody gaming mice (WebHID + PWA).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
